# Sao chép thành portal/docker/.env
#
# Prefix tên Compose project + container (khớp stack trong docker/routes.json).
PORTAL_STACK_PREFIX=base
#
# Trùng BASE_SHARED_NETWORK_NAME trong docker/.env — portal join mạng này để gateway gọi <PORTAL_STACK_PREFIX>-portal-node:3000.
BASE_SHARED_NETWORK_NAME=base_shared_net
#
# Trùng id -u / id -g trên host — pnpm/next trong container không tạo file .next dưới quyền root trên bind mount.
HOST_UID=1000
HOST_GID=1000
#
# Biến Next/API: đặt trong portal/.env hoặc apps/web/.env, ví dụ NEXT_PUBLIC_API_URL=http://api-node:4000
